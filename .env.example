# Clé API Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé. claude-opus-5 est le plus fiable en maths.
# claude-sonnet-5 coûte environ 2,5 fois moins cher, avec un peu plus de risque d'erreur.
MODELE=claude-opus-5

# Nombre maximum d'appels par jour (garde-fou contre une facture qui s'emballe)
PLAFOND_JOUR=150

# Port du serveur
PORT=3000

# Code d'accès. Laisse vide pour un usage sur le PC uniquement.
# Renseigne-le dès que le serveur est accessible depuis l'extérieur.
CODE_ACCES=
